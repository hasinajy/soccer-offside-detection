<Window x:Class="UI.ScoreTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Score Tracker"
        Height="600"
        Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Score Display Row -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20">
            <TextBlock Text="Team A"
                       FontSize="24"
                       VerticalAlignment="Center"/>
            <TextBlock Text=" "
                       FontSize="24"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="ScoreTeamA"
                       Text="0"
                       FontSize="24"
                       VerticalAlignment="Center"/>
            <TextBlock Text=" - "
                       FontSize="24"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="ScoreTeamB"
                       Text="0"
                       FontSize="24"
                       VerticalAlignment="Center"/>
            <TextBlock Text=" "
                       FontSize="24"
                       VerticalAlignment="Center"/>
            <TextBlock Text="Team B"
                       FontSize="24"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Images Row -->
        <Grid Grid.Row="1"
              Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Before Image Column -->
            <StackPanel Grid.Column="0"
                        Margin="0,0,10,0">
                <TextBlock Text="Before Image"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <Border BorderBrush="Gray"
                        BorderThickness="1">
                    <Image x:Name="BeforeImage"
                           Stretch="Uniform"
                           Height="300"/>
                </Border>
                <Button Content="Import Before Image"
                        Margin="0,10,0,0"
                        Padding="10,5"
                        Click="ImportBeforeImage_Click"/>
            </StackPanel>

            <!-- After Image Column -->
            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0">
                <TextBlock Text="After Image"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <Border BorderBrush="Gray"
                        BorderThickness="1">
                    <Image x:Name="AfterImage"
                           Stretch="Uniform"
                           Height="300"/>
                </Border>
                <Button Content="Import After Image"
                        Margin="0,10,0,0"
                        Padding="10,5"
                        Click="ImportAfterImage_Click"/>
            </StackPanel>
        </Grid>

        <!-- Process Button Row -->
        <Button Grid.Row="2"
                Content="Process Images"
                HorizontalAlignment="Center"
                Margin="0,20"
                Padding="20,10"
                Click="ProcessImages_Click"/>
    </Grid>
</Window>